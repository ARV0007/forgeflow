# Copy to .env, fill in, then load it into your shell before running:
#   set -a; source .env; set +a; ./mvnw spring-boot:run
# (.env is git-ignored. Never commit real keys.)

# --- model -------------------------------------------------------------
GOOGLE_API_KEY=
# gemini (default) | demo (offline stand-in, no key needed)
FORGEFLOW_LLM_PROVIDER=gemini

# --- database ----------------------------------------------------------
DB_URL=jdbc:postgresql://localhost:5433/forgeflow
DB_USERNAME=forgeflow
DB_PASSWORD=forgeflow

# --- auth --------------------------------------------------------------
# Any long random string. Changing it signs everyone out. Left commented,
# the app uses a dev-only default - an EMPTY value here would override that.
# JWT_SECRET=

# --- sandbox -----------------------------------------------------------
# docker (needs Docker running) | in-process (no Docker)
FORGEFLOW_SANDBOX_PROVIDER=docker

# --- optional ----------------------------------------------------------
# REDIS_URL=redis://localhost:6379
# ZIPKIN_URL=http://localhost:9411
# FORGEFLOW_EMBEDDER=hashing
# FORGEFLOW_BILLING_PROVIDER=fake
