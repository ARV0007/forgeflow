{
  "_comment": "Labelled questions over evals/retrieval/fixture (FreshCart, 29 files). 'expect' is the file a developer would open first; 'accept' lists other files that are also a fair answer. Three kinds: identifier = an exact name from the code; described = plain words that also appear in the code; paraphrase = the same idea in different words, the case meaning-based search exists for. Keep this file stable: numbers are only comparable across runs on the same questions.",
  "queries": [
    { "kind": "identifier", "q": "applyPromoCode", "expect": "js/discounts.js" },
    { "kind": "identifier", "q": "formatPrice", "expect": "js/currency.js" },
    { "kind": "identifier", "q": "renderProductGrid", "expect": "js/products.js" },
    { "kind": "identifier", "q": "luhnValid", "expect": "js/validation.js" },
    { "kind": "identifier", "q": "toggleWishlist", "expect": "js/wishlist.js" },
    { "kind": "identifier", "q": "generateOrderNumber", "expect": "js/checkout.js" },
    { "kind": "identifier", "q": "amountToFreeDelivery", "expect": "js/shipping.js" },
    { "kind": "identifier", "q": "translatePage", "expect": "js/i18n.js" },
    { "kind": "identifier", "q": "updateCartBadge", "expect": "js/cart.js" },
    { "kind": "identifier", "q": "sortProducts", "expect": "js/product-filter.js" },
    { "kind": "identifier", "q": "formatOrderDate", "expect": "js/order-history.js" },
    { "kind": "identifier", "q": "trackEvent", "expect": "js/analytics.js" },
    { "kind": "identifier", "q": "FREE_OVER_PENCE", "expect": "js/shipping.js" },
    { "kind": "identifier", "q": "showFieldError", "expect": "js/validation.js" },

    { "kind": "described", "q": "where is the discount from a promo code calculated", "expect": "js/discounts.js" },
    { "kind": "described", "q": "card number validation", "expect": "js/validation.js" },
    { "kind": "described", "q": "sort products by price", "expect": "js/product-filter.js" },
    { "kind": "described", "q": "dark theme colours", "expect": "css/theme-dark.css", "accept": ["js/theme.js"] },
    { "kind": "described", "q": "header navigation layout on small screens", "expect": "css/layout.css" },
    { "kind": "described", "q": "sold out label on product cards", "expect": "css/product-card.css", "accept": ["js/products.js"] },
    { "kind": "described", "q": "remove an item from the cart", "expect": "js/cart.js", "accept": ["js/cart-page.js"] },
    { "kind": "described", "q": "promo code input form", "expect": "cart.html", "accept": ["js/cart-page.js"] },
    { "kind": "described", "q": "checkout delivery address fields", "expect": "checkout.html" },
    { "kind": "described", "q": "sign in form with email and password", "expect": "account.html", "accept": ["js/auth.js"] },
    { "kind": "described", "q": "session expires after seven days", "expect": "js/auth.js" },
    { "kind": "described", "q": "evening delivery surcharge", "expect": "js/shipping.js" },
    { "kind": "described", "q": "list of past orders on the account page", "expect": "js/order-history.js" },
    { "kind": "described", "q": "order summary box styles", "expect": "css/cart.css" },

    { "kind": "paraphrase", "q": "how much does it cost to bring the groceries to my house", "expect": "js/shipping.js" },
    { "kind": "paraphrase", "q": "fall back to memory when saving data locally is not allowed", "expect": "js/storage.js" },
    { "kind": "paraphrase", "q": "little message that appears for a moment to tell the user something happened", "expect": "js/toast.js" },
    { "kind": "paraphrase", "q": "show the website in another language", "expect": "js/i18n.js" },
    { "kind": "paraphrase", "q": "make the site easier on the eyes at night", "expect": "js/theme.js", "accept": ["css/theme-dark.css"] },
    { "kind": "paraphrase", "q": "display amounts of money with a pound sign", "expect": "js/currency.js" },
    { "kind": "paraphrase", "q": "reject a bank card whose end date is in the past", "expect": "js/validation.js" },
    { "kind": "paraphrase", "q": "buy the same things I bought last time", "expect": "js/order-history.js" },
    { "kind": "paraphrase", "q": "heart button to keep a product for later", "expect": "js/wishlist.js", "accept": ["css/product-card.css"] },
    { "kind": "paraphrase", "q": "count how often visitors do things on the site", "expect": "js/analytics.js" },
    { "kind": "paraphrase", "q": "hide things that are not available to buy right now", "expect": "js/product-filter.js", "accept": ["products.html"] },
    { "kind": "paraphrase", "q": "pick the best sellers to show on the front page", "expect": "js/app.js" },
    { "kind": "paraphrase", "q": "wait until the shopper stops typing before searching", "expect": "js/product-filter.js" },
    { "kind": "paraphrase", "q": "the big welcome banner at the top of the home page", "expect": "index.html", "accept": ["css/layout.css"] }
  ]
}
